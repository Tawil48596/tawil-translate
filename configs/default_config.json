{
  "audio": {
    "target_pid": null,
    "target_executable": null,
    "sample_rate": 16000,
    "frame_ms": 20,
    "helper_path": "bin/tawil-audio-capture.exe"
  },
  "vad": {
    "provider": "silero",
    "threshold": 0.5,
    "min_silence_ms": 280,
    "min_speech_ms": 180
  },
  "stt": {
    "profile": "balanced",
    "model": null,
    "device": "auto",
    "compute_type": "auto",
    "source_language": null,
    "model_dir": "models",
    "download_source": "auto"
  },
  "translation": {
    "enabled": true,
    "provider": "openai-compatible",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4.1-mini",
    "api_key_env": "TAWIL_API_KEY",
    "daily_token_limit": 100000,
    "custom_prompt": "你是专业的游戏与直播实时字幕翻译器。请将输入内容翻译为{target_language}。\n要求：只输出译文，不解释、不添加前缀；保持人物语气、情绪、数字和格式；结合最近上下文消解指代；专有名词严格遵循词库；听写不完整时优先给出自然、简洁且适合字幕阅读的译文。\n词库约束：{glossary}"
  },
  "overlay": {"opacity": 0.86, "click_through": true, "hotkey": "Ctrl+Shift+T"},
  "pipeline": {
    "queue_size": 6,
    "context_size": 6,
    "overflow_policy": "drop_oldest",
    "max_segment_seconds": 8.0,
    "merge_gap_ms": 260
  }
}
