{
  "audio": {
    "target_pid": null,
    "target_executable": null,
    "sample_rate": 16000,
    "frame_ms": 20,
    "helper_path": "bin/tawil-audio-capture.exe"
  },
  "vad": {
    "provider": "silero",
    "threshold": 0.5,
    "min_silence_ms": 450,
    "min_speech_ms": 200
  },
  "stt": {
    "profile": "balanced",
    "model": null,
    "device": "auto",
    "compute_type": "auto",
    "source_language": null,
    "model_dir": "models",
    "download_source": "auto"
  },
  "translation": {
    "enabled": true,
    "provider": "openai-compatible",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4.1-mini",
    "api_key_env": "TAWIL_API_KEY",
    "daily_token_limit": 100000,
    "timeout_seconds": 12.0,
    "first_token_timeout_seconds": 1.5,
    "total_timeout_seconds": 3.0,
    "concurrency": 3,
    "custom_prompt": "你是实时游戏与直播字幕翻译器。把输入翻译为{target_language}。\n只输出简洁、自然的译文，不解释、不加前缀；保留语气、数字与格式。\n严格使用这些术语：{glossary}"
  },
  "overlay": {"opacity": 0.86, "click_through": true, "hotkey": "Ctrl+Shift+T"},
  "pipeline": {
    "queue_size": 6,
    "context_size": 6,
    "overflow_policy": "drop_oldest",
    "max_segment_seconds": 12.0,
    "merge_gap_ms": 260,
    "preview_interval_ms": 1200,
    "preview_min_speech_ms": 900
  }
}
